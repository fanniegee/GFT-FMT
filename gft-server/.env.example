# Copy this file to .env and fill in real values.
NODE_ENV=development
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://gft_user:CHANGE_THIS_PASSWORD@localhost:5432/gft

# Browser origins allowed to call the API.
# Add your real production domain later.
FRONTEND_ORIGINS=http://localhost:3000

# Generate a long random secret before production.
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
